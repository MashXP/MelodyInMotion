[
  {
    "id": "tutorial_solfege",
    "title": "Tutorial: Solfège Basics",
    "description": "Learn the 7 core Solfège hand signs at octave C4 (3 fingers on left hand). Show the sign and hold it to proceed.",
    "isTutorial": true,
    "bpm": 60,
    "notes": [
      {
        "beat": 4,
        "note": "DO",
        "octave": 4,
        "duration": 2,
        "instruction": "Form a Fist (DO) with your sign hand. Extend 3 fingers on your octave hand for C4."
      },
      {
        "beat": 8,
        "note": "RE",
        "octave": 4,
        "duration": 2,
        "instruction": "Open your hand and point fingers down-forward at an angle (RE) at octave C4."
      },
      {
        "beat": 12,
        "note": "MI",
        "octave": 4,
        "duration": 2,
        "instruction": "Keep your hand flat and horizontal (MI) parallel to the floor at octave C4."
      },
      {
        "beat": 16,
        "note": "FA",
        "octave": 4,
        "duration": 2,
        "instruction": "Form a thumbs down shape (FA) pointing your thumb towards the floor at octave C4."
      },
      {
        "beat": 20,
        "note": "SOL",
        "octave": 4,
        "duration": 2,
        "instruction": "Show your flat palm sideways (SOL) facing left/sideways at octave C4."
      },
      {
        "beat": 24,
        "note": "LA",
        "octave": 4,
        "duration": 2,
        "instruction": "Curve your fingers downwards in a soft claw shape (LA) facing the floor at octave C4."
      },
      {
        "beat": 28,
        "note": "TI",
        "octave": 4,
        "duration": 2,
        "instruction": "Point straight up with your index finger (TI) at octave C4."
      }
    ]
  },
